{
  "global": {
    "check_for_updates_on_startup": true,
    "show_in_menu_bar": false,
    "show_profile_name_in_menu_bar": false
  },
  "profiles": [
    {
      "name": "Default",
      "selected": true,
      "simple_modifications": [
        {
          "from": { "key_code": "left_command" },
          "to": [{ "key_code": "fn" }]
        }
      ],
      "complex_modifications": {
        "rules": [
          {
            "description": "coding agent: Enter を shift+Enter にする (改行)",
            "manipulators": [
              {
                "type": "basic",
                "from": { "key_code": "return_or_enter" },
                "to": [{ "key_code": "return_or_enter", "modifiers": ["left_shift"] }],
                "conditions": [
                  {
                    "type": "frontmost_application_if",
                    "bundle_identifiers": [
                      "^com\\.github\\.wez\\.wezterm$",
                      "^com\\.openai\\.codex$",
                      "^com\\.stablyai\\.orca$",
                      "^com\\.anysphere\\.sand$"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "description": "coding agent: 右 cmd+Enter を素の Enter にする (送信)",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "return_or_enter",
                  "modifiers": { "mandatory": ["right_command"] }
                },
                "to": [{ "key_code": "return_or_enter" }],
                "conditions": [
                  {
                    "type": "frontmost_application_if",
                    "bundle_identifiers": [
                      "^com\\.github\\.wez\\.wezterm$",
                      "^com\\.openai\\.codex$",
                      "^com\\.stablyai\\.orca$",
                      "^com\\.anysphere\\.sand$"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "description": "fn+hjkl to arrow keys (vim-like)",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "h",
                  "modifiers": { "mandatory": ["fn"] }
                },
                "to": [{ "key_code": "left_arrow" }]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "j",
                  "modifiers": { "mandatory": ["fn"] }
                },
                "to": [{ "key_code": "down_arrow" }]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "k",
                  "modifiers": { "mandatory": ["fn"] }
                },
                "to": [{ "key_code": "up_arrow" }]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "l",
                  "modifiers": { "mandatory": ["fn"] }
                },
                "to": [{ "key_code": "right_arrow" }]
              }
            ]
          },
          {
            "description": "shift+fn+hjkl to shift+arrow keys (extend selection, vim-like)",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "h",
                  "modifiers": { "mandatory": ["fn", "shift"] }
                },
                "to": [{ "key_code": "left_arrow", "modifiers": ["left_shift"] }]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "j",
                  "modifiers": { "mandatory": ["fn", "shift"] }
                },
                "to": [{ "key_code": "down_arrow", "modifiers": ["left_shift"] }]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "k",
                  "modifiers": { "mandatory": ["fn", "shift"] }
                },
                "to": [{ "key_code": "up_arrow", "modifiers": ["left_shift"] }]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "l",
                  "modifiers": { "mandatory": ["fn", "shift"] }
                },
                "to": [{ "key_code": "right_arrow", "modifiers": ["left_shift"] }]
              }
            ]
          },
          {
            "description": "cmd+fn+hjkl to cmd+arrow keys (line start/end, doc start/end, vim-like)",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "h",
                  "modifiers": { "mandatory": ["command", "fn"], "optional": ["any"] }
                },
                "to": [{ "key_code": "left_arrow", "modifiers": ["left_command"] }]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "j",
                  "modifiers": { "mandatory": ["command", "fn"], "optional": ["any"] }
                },
                "to": [{ "key_code": "down_arrow", "modifiers": ["left_command"] }]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "k",
                  "modifiers": { "mandatory": ["command", "fn"], "optional": ["any"] }
                },
                "to": [{ "key_code": "up_arrow", "modifiers": ["left_command"] }]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "l",
                  "modifiers": { "mandatory": ["command", "fn"], "optional": ["any"] }
                },
                "to": [{ "key_code": "right_arrow", "modifiers": ["left_command"] }]
              }
            ]
          },
          {
            "description": "shift+cmd+fn+hjkl to shift+cmd+arrow keys (extend selection to line/doc start/end, vim-like)",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "h",
                  "modifiers": { "mandatory": ["command", "shift", "fn"], "optional": ["any"] }
                },
                "to": [{ "key_code": "left_arrow", "modifiers": ["left_command", "left_shift"] }]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "j",
                  "modifiers": { "mandatory": ["command", "shift", "fn"], "optional": ["any"] }
                },
                "to": [{ "key_code": "down_arrow", "modifiers": ["left_command", "left_shift"] }]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "k",
                  "modifiers": { "mandatory": ["command", "shift", "fn"], "optional": ["any"] }
                },
                "to": [{ "key_code": "up_arrow", "modifiers": ["left_command", "left_shift"] }]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "l",
                  "modifiers": { "mandatory": ["command", "shift", "fn"], "optional": ["any"] }
                },
                "to": [{ "key_code": "right_arrow", "modifiers": ["left_command", "left_shift"] }]
              }
            ]
          },
          {
            "description": "control+fn+f/b to page down/up (vim-like)",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "f",
                  "modifiers": { "mandatory": ["control", "fn"], "optional": ["any"] }
                },
                "to": [{ "key_code": "page_down" }]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "b",
                  "modifiers": { "mandatory": ["control", "fn"], "optional": ["any"] }
                },
                "to": [{ "key_code": "page_up" }]
              }
            ]
          },
          {
            "description": "cmd+option+fn+f to sleep",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "f",
                  "modifiers": { "mandatory": ["command", "option", "fn"] }
                },
                "to": [{ "shell_command": "/bin/sleep 1 && /usr/bin/pmset sleepnow" }]
              }
            ]
          }
        ]
      },
      "devices": [],
      "fn_function_keys": [],
      "virtual_hid_keyboard": {
        "keyboard_type_v2": "ansi"
      }
    }
  ]
}
