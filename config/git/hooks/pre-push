#!/bin/sh
# Grok Bot の Shell（SAND_AGENT=1）からの push を拒否する。
# infra repo の vibe_coding_repositories.tf に定義されていれば許可する。
# pre-push は --no-verify で飛ばせるため、強制力のある防御ではなく誤操作を防ぐ歯止めである。

if [ "$SAND_AGENT" = "1" ]; then
  SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd -P)
  "$SCRIPT_DIR/is-vibe-coding-repo.sh" && exit 0
  echo "エラー: Grok Bot からの push は禁止されている。push はユーザーが自分で行う。" >&2
  exit 1
fi

exit 0
