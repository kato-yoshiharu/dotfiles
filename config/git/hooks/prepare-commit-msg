#!/bin/sh
# Grok Bot の Shell（SAND_AGENT=1）からのコミットを拒否する。
# infra repo の vibe_coding_repositories.tf に定義されていれば許可する。
# pre-commit ではなく prepare-commit-msg にしているのは、--no-verify で飛ばされず、
# amend・cherry-pick・merge のコミットにも走るため。

if [ "$SAND_AGENT" = "1" ]; then
  SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd -P)
  "$SCRIPT_DIR/is-vibe-coding-repo.sh" && exit 0
  echo "エラー: Grok Bot からのコミットは禁止されている。コミットはユーザーが自分で行う。" >&2
  exit 1
fi

exit 0
