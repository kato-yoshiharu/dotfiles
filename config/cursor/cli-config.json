{
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(**)",
      "Shell(ls)",
      "Shell(backlog)"
    ],
    "deny": [
      "Shell(gh:repo delete*)",
      "Shell(gh:repo archive*)",
      "Shell(gh:release delete*)",
      "Shell(gh:secret delete*)",
      "Shell(gh:api*DELETE*)",
      "Shell(gh:api*delete*)",
      "Shell(terraform:destroy*)",
      "Shell(terraform:apply*-auto-approve*)"
    ]
  },
  "attribution": {
    "attributeCommitsToAgent": false,
    "attributePRsToAgent": false
  },
  "editor": {
    "vimMode": true
  },
  "approvalMode": "auto-review",
  "notifications": true
}
