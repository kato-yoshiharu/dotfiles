{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "bash \"$HOME/.agents/hooks/block-git-write.sh\"",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "sessionStart": [
      {
        "command": "bash \"$HOME/.agents/hooks/cursor-session-start.sh\"",
        "timeout": 10
      }
    ]
  }
}
