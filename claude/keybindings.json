{
  "$schema": "https://www.schemastore.org/claude-code-keybindings.json",
  "$docs": "https://code.claude.com/docs/en/keybindings",
  "bindings": [
    {
      "context": "Chat",
      "bindings": {
        "enter": "chat:newline",
        "meta+enter": "chat:submit",
        "cmd+z": "chat:undo",
        "meta+z": "chat:undo"
      }
    },
    {
      "context": "Select",
      "bindings": {
        "enter": null,
        "meta+enter": "select:accept"
      }
    }
  ]
}
